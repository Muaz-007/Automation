{
  "name": "Talkential — WhatsApp Lead Router",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "talkential-lead",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-8000-000000000001",
      "name": "WhatsApp Lead Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400],
      "webhookId": "talkential-lead-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Normalize incoming lead payload from Talkential dashboard\nconst payload = $input.first().json;\n\nconst lead = {\n  event_type: payload.type || 'lead.created',\n  tenant_id: payload.tenant_id,\n  lead_id: payload.lead_id,\n  customer_name: payload.customer?.name || 'Unknown',\n  customer_phone: payload.customer?.phone,\n  customer_city: payload.customer?.city || 'N/A',\n  hot_score: payload.lead?.hot_score || 0,\n  status: payload.lead?.status || 'new',\n  source: payload.lead?.source || 'whatsapp',\n  extracted_data: payload.lead?.extracted_data || {},\n  last_message: payload.last_message || '',\n  handoff_reason: payload.handoff_reason || null,\n  received_at: new Date().toISOString()\n};\n\n// Classification logic\nlead.priority = lead.event_type === 'lead.handoff' ? 'urgent'\n              : lead.hot_score >= 75 ? 'hot'\n              : 'standard';\n\nreturn { json: lead };"
      },
      "id": "a1b2c3d4-0002-4000-8000-000000000002",
      "name": "Normalize Lead Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 400]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.priority }}",
                    "rightValue": "urgent",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Urgent Handoff"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.priority }}",
                    "rightValue": "hot",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Hot Lead"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.priority }}",
                    "rightValue": "standard",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Standard Lead"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-8000-000000000003",
      "name": "Route by Priority",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [680, 400]
    },
    {
      "parameters": {
        "channel": "#sales-urgent",
        "text": "=🚨 *URGENT HANDOFF NEEDED*\n\n*Customer:* {{ $json.customer_name }} ({{ $json.customer_phone }})\n*City:* {{ $json.customer_city }}\n*Reason:* {{ $json.handoff_reason }}\n*Last message:* _{{ $json.last_message }}_\n\n<https://app.talkential.com/leads/{{ $json.lead_id }}|View lead →>",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0004-4000-8000-000000000004",
      "name": "Slack — Alert Owner",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [900, 200]
    },
    {
      "parameters": {
        "url": "https://api.trello.com/1/cards",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "idList",
              "value": "YOUR_TRELLO_LIST_ID"
            },
            {
              "name": "name",
              "value": "=🔥 {{ $json.customer_name }} — needs human ({{ $json.customer_city }})"
            },
            {
              "name": "desc",
              "value": "=Phone: {{ $json.customer_phone }}\\nReason: {{ $json.handoff_reason }}\\nLast msg: {{ $json.last_message }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-8000-000000000005",
      "name": "Create Trello Task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 200]
    },
    {
      "parameters": {
        "channel": "#sales-hot-leads",
        "text": "=🔥 *Hot Lead* ({{ $json.hot_score }}/100)\n\n*{{ $json.customer_name }}* from *{{ $json.customer_city }}*\nInterested in: {{ JSON.stringify($json.extracted_data) }}\n\n<https://app.talkential.com/leads/{{ $json.lead_id }}|Open in Talkential →>",
        "otherOptions": {}
      },
      "id": "a1b2c3d4-0006-4000-8000-000000000006",
      "name": "Slack — Notify Sales",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [900, 400]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Hot Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.received_at }}",
            "Lead ID": "={{ $json.lead_id }}",
            "Customer": "={{ $json.customer_name }}",
            "Phone": "={{ $json.customer_phone }}",
            "City": "={{ $json.customer_city }}",
            "Hot Score": "={{ $json.hot_score }}",
            "Source": "={{ $json.source }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1b2c3d4-0007-4000-8000-000000000007",
      "name": "Sheets — Log Hot Lead",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "amount": 5,
        "unit": "minutes"
      },
      "id": "a1b2c3d4-0008-4000-8000-000000000008",
      "name": "Wait 5 min",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [1340, 400],
      "webhookId": "wait-hot-follow-up"
    },
    {
      "parameters": {
        "url": "=https://graph.facebook.com/v20.0/{{ $env.META_PHONE_NUMBER_ID }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"messaging_product\": \"whatsapp\",\n  \"to\": \"{{ $json.customer_phone }}\",\n  \"type\": \"text\",\n  \"text\": {\n    \"body\": \"Hi {{ $json.customer_name }}, our sales rep will contact you within the next 10 minutes to discuss your requirements. Thank you for your patience!\"\n  }\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0009-4000-8000-000000000009",
      "name": "WhatsApp Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1560, 400]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "All Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "Timestamp": "={{ $json.received_at }}",
            "Lead ID": "={{ $json.lead_id }}",
            "Customer": "={{ $json.customer_name }}",
            "Phone": "={{ $json.customer_phone }}",
            "Status": "={{ $json.status }}",
            "Source": "={{ $json.source }}"
          },
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1b2c3d4-0010-4000-8000-000000000010",
      "name": "Sheets — Log Standard",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [900, 600]
    },
    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "a1b2c3d4-0011-4000-8000-000000000011",
      "name": "Merge Branches",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [1780, 400]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://app.talkential.com/api/leads/{{ $json.lead_id }}/notified",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"notified_at\": \"{{ $json.received_at }}\",\n  \"channels\": [\"slack\", \"sheets\"],\n  \"priority\": \"{{ $json.priority }}\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0012-4000-8000-000000000012",
      "name": "Update Talkential Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2000, 400]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"ok\": true,\n  \"lead_id\": \"{{ $json.lead_id }}\",\n  \"routed_as\": \"{{ $json.priority }}\",\n  \"processed_at\": \"{{ $json.received_at }}\"\n}",
        "options": {}
      },
      "id": "a1b2c3d4-0013-4000-8000-000000000013",
      "name": "Respond to Talkential",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [2220, 400]
    }
  ],
